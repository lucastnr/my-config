[
  {
    "context": "Editor",
    "bindings": {
      "shift-alt-f": "editor::Format",
    },
  },
  {
    "bindings": {
      "cmd-shift-g": "git_panel::ToggleFocus",
      "cmd-shift-d": "git_panel::ToggleFocus",
      "cmd-shift-x": "agent::ToggleFocus",
      "alt-z": "editor::ToggleSoftWrap",
      "ctrl-r": "projects::OpenRecent",
      "cmd-b": "workspace::ToggleRightDock",
      "cmd-shift-c": [
        "task::Spawn",
        {
          "task_name": "Open external terminal",
        },
      ],
    },
  },
  {
    "context": "Pane",
    "bindings": {
      "cmd-ctrl-g": "search::SelectPreviousMatch",
      "alt-ctrl-c": "search::ToggleCaseSensitive",
      "alt-ctrl-x": "search::ToggleWholeWord",
    },
  },
  {
    "context": "Editor && (extension==js || extension==jsx || extension==ts || extension==tsx)",
    "bindings": {
      "alt-d": [
        "workspace::SendKeystrokes",
        "/** enter enter space */ up space * space",
      ],
      "alt-l": ["workspace::SendKeystrokes", "enter * space"],
    },
  },
  {
    "context": "Workspace",
    "bindings": {
      "cmd-r": null,
    },
  },
  {
    "context": "Terminal",
    "bindings": {
      "alt-cmd-r": null,
    },
  },
  {
    "context": "ProjectPanel",
    "bindings": {
      "cmd-k p": "workspace::CopyRelativePath",
    },
  },
  {
    "context": "Editor",
    "bindings": {
      "cmd-k p": "editor::CopyRelativePath",
    },
  },
]
