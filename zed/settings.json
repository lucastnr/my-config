{
	"cli_default_open_behavior": "existing_window",
	"diff_view_style": "unified",
	"collaboration_panel": {
		"dock": "left"
	},
	"edit_predictions": {
		"provider": "zed"
	},
	"show_wrap_guides": true,
	"agent_servers": {
		"claude-acp": {
			"default_config_options": {
				"model": "default",
				"mode": "plan",
				"effort": "high"
			},
			"favorite_config_option_values": {
				"model": ["opus"]
			},
			"type": "registry"
		}
	},
	"vim_mode": false,
	"ssh_connections": [
		{
			"host": "192.168.0.158",
			"username": "pi",
			"args": [],
			"projects": [
				{
					"paths": ["/home/pi/cj-bot-js"]
				}
			]
		}
	],
	"agent": {
		"single_file_review": false,
		"inline_assistant_model": {
			"provider": "copilot_chat",
			"model": "gpt-4.1"
		},
		"commit_message_model": {
			"provider": "copilot_chat",
			"model": "claude-opus-4.5"
		},
		"profiles": {},
		"default_model": {
			"provider": "copilot_chat",
			"model": "claude-sonnet-4"
		},
		"dock": "right"
	},
	"base_keymap": "VSCode",
	"theme": {
		"mode": "system",
		"dark": "One Black",
		"light": "One Light"
	},
	"experimental.theme_overrides": {
		"editor.background": "#00000",
		"syntax": {
			"comment": {
				"color": "#878e98"
			}
		}
	},
	"project_panel": {
		"dock": "right"
	},
	"git_panel": {
		"dock": "right"
	},
	"outline_panel": {
		"dock": "right"
	},
	"auto_update": true,
	"soft_wrap": "editor_width",
	"ui_font_size": 20,
	"buffer_font_size": 16,
	"format_on_save": "on",
	"formatter": {
		"language_server": {
			"name": "biome"
		}
	},
	"file_types": {
		"HTML": ["svg"]
	},
	"languages": {
		"TypeScript": {
			"code_actions_on_format": {
				"source.organizeImports.biome": true
			}
		},
		"TSX": {
			"code_actions_on_format": {
				"source.organizeImports.biome": true
			}
		},
		"Python": {
			"language_servers": ["ty"]
		}
	},
	"lsp": {
		"tailwindcss-language-server": {
			"settings": {
				"experimental": {
					"classRegex": [
						["cva\\(([^)]*)\\)", "[\"'`]([^\"'`]*).*?[\"'`]"],
						["cx\\(([^)]*)\\)", "(?:'|\"|`)([^']*)(?:'|\"|`)"]
					]
				}
			}
		},
		"ty": {
			"settings": {
				"configuration": {
					"environment": {
						"python": "~/.pyenv"
					}
				}
			}
		}
	},
	"file_scan_inclusions": ["apps/web/.env*", "apps/bifrost/.env*", ".env*"],
	"file_scan_exclusions": [
		// Start Zed Defaults
		"**/.git",
		"**/.svn",
		"**/.hg",
		"**/.jj",
		"**/CVS",
		"**/.DS_Store",
		"**/Thumbs.db",
		"**/.classpath",
		"**/.settings",
		// End Zed Defaults
		"**/.yarn",
		"**/.nx",
		"**/.idea",
		"**/android/app/build",
		"**/ios/Pods",
		"**/.cursor",
		"**/.claude/worktrees",
		"**/.next",
		"**/.vercel",
		"**/dist"
	],
	"context_servers": {
		// "atlassian": {
		//   "command": "npx",
		//   "args": ["mcp-remote", "https://mcp.atlassian.com/v1/sse"]
		// },
		"browser-tools-context-server": {
			"enabled": true,
			"remote": false,
			"settings": {}
		},
		"playwright": {
			"command": "npx",
			"args": ["-y", "@playwright/mcp-server"]
		},
		"fetch": {
			"command": "npx",
			"args": ["-y", "@kazuph/mcp-fetch"]
		},
		"browser-tools": {
			"command": "npx",
			"args": ["-y", "@agentdeskai/browser-tools-mcp"]
		}
		// "figma": {
		//   "command": "npx",
		//   "args": [
		//     "-y",
		//     "figma-developer-mcp",
		//     "--figma-api-key=YOUR-KEY",
		//     "--stdio"
		//   ]
		// }
	}
}
